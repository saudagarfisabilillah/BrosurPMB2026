                            aria-hidden="true">
                            <path d="M6 9l6 6 6-6" />
                        </svg>
                    </summary>
                    <div class="px-5 md:px-6 pb-5 -mt-1">
                        <p class="text-sm text-neutral-600 leading-relaxed">Ya. SMP Alkarim Rasyid menggunakan kurikulum
                            nasional yang diintegrasikan dengan nilai-nilai keislaman serta pembinaan Al-Qur'an, dakwah,
                            dan pembentukan karakter.</p>
                    </div>
                </details>

                <details class="faq reveal bg-white rounded-2xl border border-gold-500/25 shadow-card overflow-hidden">
                    <summary class="flex items-center justify-between gap-4 px-5 md:px-6 py-4">
