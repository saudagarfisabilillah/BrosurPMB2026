    <section id="kuota" class="relative py-14 md:py-20 px-4 bg-ivory-100 pattern-star">
        <div class="max-w-3xl mx-auto">
            <div
                class="reveal bg-gradient-to-br from-blush-50 via-ivory-50 to-gold-50 border border-gold-500/50 rounded-3xl shadow-card p-7 md:p-10 text-center">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-700">Catatan Penting</p>
                <h2 class="font-display text-2xl md:text-4xl font-extrabold text-burgundy-900 mt-3 leading-snug">Kuota
                    Setiap Gelombang Terbatas</h2>
                <p class="text-neutral-600 mt-4 leading-relaxed max-w-2xl mx-auto">Daya tampung kelas dan asrama sengaja
                    dibatasi agar kualitas pembinaan tetap terjaga. Ketika kuota satu gelombang terisi, pendaftar akan
                    diarahkan ke gelombang berikutnya. Permintaan brosur tetap gratis — yang terbatas adalah kuota dan
                    penanganannya.</p>

                <p class="mt-7 text-sm font-bold text-burgundy-800 uppercase tracking-wider">Gelombang 1 berakhir dalam:
                </p>
                <div id="countdown" class="flex items-stretch justify-center gap-2.5 md:gap-4 mt-4" role="timer"
                    aria-label="Waktu berakhirnya Gelombang 1">
                    <div
                        class="cd-box bg-white rounded-2xl border border-gold-500/40 shadow-card px-3 py-3 md:px-5 text-center">
                        <p id="cdDays"
                            class="font-display text-3xl md:text-4xl font-extrabold text-burgundy-900 leading-none tabular-nums">
                            00</p>
                        <p class="text-[10px] md:text-xs text-neutral-500 font-semibold tracking-wider mt-1.5">HARI</p>
                    </div>
                    <div
                        class="cd-box bg-white rounded-2xl border border-gold-500/40 shadow-card px-3 py-3 md:px-5 text-center">
                        <p id="cdHours"
                            class="font-display text-3xl md:text-4xl font-extrabold text-burgundy-900 leading-none tabular-nums">
                            00</p>
                        <p class="text-[10px] md:text-xs text-neutral-500 font-semibold tracking-wider mt-1.5">JAM</p>
                    </div>
                    <div
                        class="cd-box bg-white rounded-2xl border border-gold-500/40 shadow-card px-3 py-3 md:px-5 text-center">
                        <p id="cdMins"
                            class="font-display text-3xl md:text-4xl font-extrabold text-burgundy-900 leading-none tabular-nums">
                            00</p>
                        <p class="text-[10px] md:text-xs text-neutral-500 font-semibold tracking-wider mt-1.5">MENIT</p>
                    </div>
                    <div
                        class="cd-box bg-white rounded-2xl border border-gold-500/40 shadow-card px-3 py-3 md:px-5 text-center">
                        <p id="cdSecs"
                            class="font-display text-3xl md:text-4xl font-extrabold text-burgundy-900 leading-none tabular-nums">
                            00</p>
                        <p class="text-[10px] md:text-xs text-neutral-500 font-semibold tracking-wider mt-1.5">DETIK</p>
                    </div>
                </div>

                <a href="https://wa.me/6282280003961?text=Assalamualaikum%2C%20saya%20ingin%20meminta%20Brosur%20Digital%20PMB%202027%2F2028%20Pondok%20Pesantren%20Qur%27an%20%26%20Dakwah%20Alkarim%20Rasyid%20Indonesia.%20Mohon%20informasinya."
                    target="_blank" rel="noopener"
                    class="btn-shine mt-8 inline-flex bg-burgundy-800 hover:bg-burgundy-700 text-white font-display font-extrabold px-9 py-4 rounded-full text-base md:text-lg shadow-soft transition">Daftar
                    Sekarang</a>
                <!-- Hidden CTA: micro-copy trust -->
                <p class="text-[11px] text-neutral-500 mt-3">Gratis • Tanpa komitmen • Direspons admin resmi PMB</p>
            </div>
        </div>
    </section>

