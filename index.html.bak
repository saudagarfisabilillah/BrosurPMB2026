    <!-- ═══════════════════════════════════════════════════
     PROCESS STEPS — 6 Langkah Pendaftaran
     ═══════════════════════════════════════════════════ -->
    <section id="alur" class="relative py-14 md:py-20 px-4 bg-gradient-to-b from-ivory-50 to-blush-50">
        <div class="max-w-3xl mx-auto">
            <div class="reveal text-center">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-700">Cara Daftar</p>
                <h2 class="font-display text-2xl md:text-4xl font-extrabold text-burgundy-900 mt-3 leading-snug">Enam
                    Langkah Menjadi Keluarga Besar Alkarim Rasyid</h2>
                <p class="text-neutral-600 mt-4 leading-relaxed max-w-2xl mx-auto">Alur pendaftarannya sederhana dan
                    terpandu. Admin PMB akan mendampingi Bapak/Ibu di setiap tahap.</p>
            </div>

            <ol class="reveal tl mt-10 space-y-0">
                <li class="relative flex gap-4 md:gap-5">
                    <div
                        class="shrink-0 w-10 h-10 rounded-full bg-burgundy-800 text-gold-300 font-display font-extrabold flex items-center justify-center ring-4 ring-ivory-50 z-10">
                        1</div>
                    <div class="pb-8">
                        <h3 class="font-display font-bold text-burgundy-900">Isi Formulir Pendaftaran</h3>
                        <p class="text-sm text-neutral-600 mt-1 leading-relaxed">Hubungi admin PMB melalui WhatsApp atau
                            scan QR Code pendaftaran, lalu isi formulir dengan data calon santri.</p>
                    </div>
                </li>
                <li class="relative flex gap-4 md:gap-5">
                    <div
                        class="shrink-0 w-10 h-10 rounded-full bg-burgundy-800 text-gold-300 font-display font-extrabold flex items-center justify-center ring-4 ring-ivory-50 z-10">
                        2</div>
                    <div class="pb-8">
                        <h3 class="font-display font-bold text-burgundy-900">Lengkapi Dokumen Persyaratan</h3>
