    <!-- ═══════════════════════════════════════════════════
     JAVASCRIPT
     ═══════════════════════════════════════════════════ -->
    <script>
            (function () {
                "use strict";

                /* ---------- Scroll reveal ---------- */
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
                    });
                }, { threshold: .12, rootMargin: "0px 0px -40px 0px" });
                document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });

                /* ---------- Header shadow saat scroll ---------- */
                var hd = document.getElementById("siteHeader");
                if (hd) {
                    window.addEventListener("scroll", function () {
                        hd.classList.toggle("header-scrolled", window.scrollY > 10);
                    }, { passive: true });
                }

                /* ---------- Countdown Timer ----------
                   TODO-JADWAL: ubah tanggal berakhirnya Gelombang 1 di baris berikut. */
                var target = new Date("2027-01-31T23:59:59+07:00").getTime();
                var cdDays = document.getElementById("cdDays"), cdHours = document.getElementById("cdHours"),
                    cdMins = document.getElementById("cdMins"), cdSecs = document.getElementById("cdSecs"),
                    cdWrap = document.getElementById("countdown"), cdTimer = null;
                function pad(n) { return String(n).padStart(2, "0"); }
                function tick() {
                    var diff = target - Date.now();
                    if (diff <= 0) {
                        if (cdWrap) { cdWrap.innerHTML = '<p class="text-sm font-semibold text-burgundy-800 py-4">Gelombang 1 telah berakhir — hubungi admin PMB untuk informasi gelombang berikutnya.</p>'; }
                        if (cdTimer) clearInterval(cdTimer);
                        return;
                    }
                    if (cdDays) cdDays.textContent = pad(Math.floor(diff / 864e5));
                    if (cdHours) cdHours.textContent = pad(Math.floor(diff % 864e5 / 36e5));
                    if (cdMins) cdMins.textContent = pad(Math.floor(diff % 36e5 / 6e4));
                    if (cdSecs) cdSecs.textContent = pad(Math.floor(diff % 6e4 / 1e3));
                }
                cdTimer = setInterval(tick, 1000); tick();

                /* ---------- Sticky bar mobile ---------- */
                var bar = document.getElementById("stickyBar"), hero = document.getElementById("hero");
                if (bar && hero) {
                    var visible = false;
                    var onScroll = function () {
                        var show = window.scrollY > Math.min(640, hero.offsetHeight * 0.7);
                        if (show !== visible) { visible = show; bar.classList.toggle("bar-show", show); }
                    };
                    window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
                }

                /* ---------- Sound effect lembut (Web Audio) ----------
                   Hanya berbunyi setelah pengguna berinteraksi dengan halaman
                   (mengikuti kebijakan autoplay browser). */
                var audioCtx = null, interacted = false;
                ["click", "touchstart", "keydown"].forEach(function (ev) {
                    document.addEventListener(ev, function () { interacted = true; }, { once: true, passive: true });
                });
                function chime() {
                    if (!interacted) return;
                    try {
                        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
                        if (audioCtx.state === "suspended") { audioCtx.resume(); }
                        var t = audioCtx.currentTime;
                        [[783.99, 0], [1174.66, 0.16]].forEach(function (pair) {
                            var f = pair[0], dl = pair[1];
                            var o = audioCtx.createOscillator(), g = audioCtx.createGain();
                            o.type = "sine"; o.frequency.value = f;
                            g.gain.setValueAtTime(0.0001, t + dl);
                            g.gain.exponentialRampToValueAtTime(0.045, t + dl + 0.04);
                            g.gain.exponentialRampToValueAtTime(0.0001, t + dl + 0.8);
                            o.connect(g); g.connect(audioCtx.destination);
                            o.start(t + dl); o.stop(t + dl + 0.9);
                        });
                    } catch (e) { }
                }

                /* ---------- Order Notification (real-time, pojok kiri bawah) ---------- */
                var people = [["Ibu Ratna", "Semarang"], ["Bapak Hendra", "Bekasi"], ["Ibu Fitriani", "Bogor"],
                ["Bapak Yusuf", "Tangerang"], ["Ibu Lestari", "Malang"], ["Bapak Iskandar", "Palembang"],
                ["Ibu Nurul", "Depok"], ["Bapak Bambang", "Surabaya"], ["Ibu Sari", "Karawang"],
                ["Bapak Ahmad", "Bandung"], ["Ibu Wulan", "Cimahi"], ["Bapak Fajar", "Depok"]];
                var actions = ["baru saja meminta Brosur Digital PMB 2027/2028",
                    "baru saja bertanya tentang PMB 2027/2028 via WhatsApp",
                    "baru saja meminta informasi pendaftaran PMB"];
                var times = ["baru saja", "1 menit lalu", "2 menit lalu", "3 menit lalu", "5 menit lalu"];
                var notif = document.getElementById("orderNotif");
                var elN = document.getElementById("notifName"), elC = document.getElementById("notifCity"),
                    elA = document.getElementById("notifAction"), elT = document.getElementById("notifTime"),
                    elI = document.getElementById("notifInitial");
                var notifCount = 0, notifTimer = null, hideTimer = null;
                function showNotif() {
                    if (!notif || notifCount >= 9 || document.hidden) return;
                    var p = people[Math.floor(Math.random() * people.length)];
                    var a = actions[Math.floor(Math.random() * actions.length)];
                    var t = times[Math.floor(Math.random() * times.length)];
                    if (elN) elN.textContent = p[0];
                    if (elC) elC.textContent = p[1];
                    if (elA) elA.textContent = a;
                    if (elT) elT.textContent = t;
                    if (elI) elI.textContent = (p[0].replace(/^(Ibu|Bapak)\s*/, "").charAt(0) || "•").toUpperCase();
                    notif.classList.remove("notif-out");
                    notif.classList.add("notif-in");
                    notif.style.opacity = "1";
                    chime();
                    notifCount++;
                    hideTimer = setTimeout(function () {
                        notif.classList.remove("notif-in"); notif.classList.add("notif-out");
                    }, 6000);
                    notifTimer = setTimeout(showNotif, 16000 + Math.random() * 14000);
                }
                if (notif) { setTimeout(showNotif, 8000); }
                var nClose = document.getElementById("notifClose");
                if (nClose) {
                    nClose.addEventListener("click", function () {
                        notifCount = 99;
                        clearTimeout(notifTimer); clearTimeout(hideTimer);
                        notif.classList.remove("notif-in"); notif.classList.add("notif-out");
                    });
                }

                /* ---------- Exit Intent Popup ----------
                   Desktop: kursor keluar ke atas jendela.
                   Mobile: scroll cepat ke atas setelah membaca 55% halaman.
                   Muncul maksimal 1x per sesi. */
                var exitModal = document.getElementById("exitModal");
                var exitShown = false;
                try { exitShown = sessionStorage.getItem("pmbExitShown") === "1"; } catch (e) { }
                function openExit() {
                    if (exitShown || !exitModal) return;
                    exitShown = true;
                    try { sessionStorage.setItem("pmbExitShown", "1"); } catch (e) { }
                    exitModal.classList.remove("hidden");
                    requestAnimationFrame(function () { exitModal.classList.remove("hide"); });
                    document.body.style.overflow = "hidden";
                }
                function closeExit() {
                    if (!exitModal) return;
                    exitModal.classList.add("hide");
                    document.body.style.overflow = "";
                    setTimeout(function () { exitModal.classList.add("hidden"); }, 350);
                }
                if (exitModal) {
                    document.getElementById("exitClose").addEventListener("click", closeExit);
                    document.getElementById("exitStay").addEventListener("click", closeExit);
                    exitModal.addEventListener("click", function (e) { if (e.target === exitModal || e.target.parentElement === exitModal && e.target.classList.contains("absolute")) closeExit(); });
                    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeExit(); });
                    document.addEventListener("mouseout", function (e) {
                        if (!e.relatedTarget && e.clientY <= 8) openExit();
                    });
                    var lastY = window.scrollY, deep = false;
                    window.addEventListener("scroll", function () {
                        var y = window.scrollY, doc = document.documentElement;
                        if (y > (doc.scrollHeight - window.innerHeight) * 0.55) deep = true;
                        if (deep && lastY - y > 140 && y < window.innerHeight * 0.4) openExit();
                        lastY = y;
                    }, { passive: true });
                }

                /* ---------- FAQ: tutup item lain saat satu dibuka ---------- */
                document.querySelectorAll("details.faq").forEach(function (d) {
                    d.addEventListener("toggle", function () {
                        if (d.open) {
                            document.querySelectorAll("details.faq").forEach(function (o) { if (o !== d) o.open = false; });
                        }
                    });
                });

                /* ---------- Tahun otomatis di footer ---------- */
                document.querySelectorAll("[data-year]").forEach(function (el) {
                    el.textContent = new Date().getFullYear();
                });
            })();
    </script>

</body>

</html>