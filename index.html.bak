                                    <div class="h-1 w-32 mx-auto bg-white/10 rounded"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="h-3 rounded-b-xl bg-gradient-to-b from-neutral-600 to-neutral-900 -mx-[4%] relative"
                        aria-hidden="true">
                        <div class="absolute left-1/2 -translate-x-1/2 top-0 w-16 h-1.5 bg-neutral-800 rounded-b-md">
                        </div>
                    </div>
