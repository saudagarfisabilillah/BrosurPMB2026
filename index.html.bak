    <section id="daftar" class="relative overflow-hidden">
        <!-- Suasana pagi hangat: cahaya keemasan -->
        <div class="absolute inset-0 bg-gradient-to-b from-ivory-50 via-blush-50 to-[#F6E3D3]" aria-hidden="true"></div>
